[Unit]
Description=Equity intraday trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/trader
EnvironmentFile=/home/trader/trader/.env
ExecStart=/home/trader/trader/.venv/bin/python main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
