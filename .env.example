# Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
# Set daily by the auth module after the login flow; do not commit a real value.
KITE_ACCESS_TOKEN=

# Bot mode: backtest | paper | live
MODE=paper

# Capital and risk
CAPITAL=100000
RISK_PCT_PER_TRADE=1.0
DAILY_LOSS_CAP_PCT=3.0
MAX_CONSECUTIVE_ERRORS=5

# Comma-separated tradingsymbols, e.g. RELIANCE,INFY,TCS
WATCHLIST=RELIANCE,INFY,TCS

# Strategy params
ORB_RANGE_MINUTES=15
ORB_CANDLE_INTERVAL=5minute
# Breakout candle's volume must be >= this multiple of the recent average
# volume to confirm the entry. Set to 0 to disable.
ORB_VOLUME_MULTIPLIER=1.5
ORB_VOLUME_LOOKBACK=20
# Only take entries on a day whose prior day's range was the narrowest of
# the last N trading days (NR7-style). Set to 0 to disable.
ORB_NR7_LOOKBACK=7
# No new entries after this time of day (24h HH:MM). Exits/EOD square-off
# are unaffected. Leave blank to disable.
ORB_ENTRY_CUTOFF_TIME=13:00

# Order params
MARKET_PROTECTION_PCT=1.0
SQUARE_OFF_TIME=15:20

# SQLite
DB_PATH=trader.db

# Cloudflare D1 dashboard sync (api/server.py's /sync endpoint).
# Account ID and D1 database ID from the Cloudflare dashboard; API token
# needs D1 edit permission on that database (create in My Profile -> API Tokens).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Shared secret the dashboard's Pages Function must present to trigger a sync.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_TOKEN=
# Must be one of Cloudflare's allowed outbound proxy ports for Workers/Pages
# Functions (HTTP: 80, 8080, 8880, 2052, 2082, 2086, 2095) or the dashboard's
# Refresh button will fail with "error code: 1003".
SYNC_API_PORT=8080
