# Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
# Set daily by the auth module after the login flow; do not commit a real value.
KITE_ACCESS_TOKEN=

# Bot mode: backtest | paper | live
MODE=paper

# Capital and risk
CAPITAL=100000
RISK_PCT_PER_TRADE=1.0
DAILY_LOSS_CAP_PCT=3.0
MAX_CONSECUTIVE_ERRORS=5

# Comma-separated tradingsymbols. Used as-is if SCAN_UNIVERSE is empty,
# otherwise only as the scanner's fallback when nothing qualifies that day.
WATCHLIST=RELIANCE,INFY,TCS

# Daily scan: each trading day, picks SCAN_TOP_N symbols from this broader
# universe based on relative-volume/gap activity that morning, instead of
# always trading the same fixed symbols. Leave empty to just use WATCHLIST
# with no scanning.
SCAN_UNIVERSE=RELIANCE,INFY,TCS,HDFCBANK,ICICIBANK,SBIN,AXISBANK,LT,ITC,TATAMOTORS
SCAN_TOP_N=3
# A symbol must clear this multiple of its average opening-range volume...
SCAN_MIN_RELATIVE_VOLUME=1.5
# ...and gap at least this % from the prior close, to qualify.
SCAN_MIN_GAP_PCT=0.5
SCAN_LOOKBACK_DAYS=20

# How many days of history run_backtest() simulates.
BACKTEST_DAYS=180

# Which strategy to run: orb | momentum_halfhour | pairs
STRATEGY=orb

# Strategy params
ORB_RANGE_MINUTES=15
ORB_CANDLE_INTERVAL=5minute
# Breakout candle's volume must be >= this multiple of the recent average
# volume to confirm the entry. Set to 0 to disable.
ORB_VOLUME_MULTIPLIER=1.5
ORB_VOLUME_LOOKBACK=20
# Only take entries on a day whose prior day's range was the narrowest of
# the last N trading days (NR7-style). Set to 0 to disable.
ORB_NR7_LOOKBACK=7
# No new entries after this time of day (24h HH:MM). Exits/EOD square-off
# are unaffected. Leave blank to disable.
ORB_ENTRY_CUTOFF_TIME=13:00
# Profit target as a multiple of the entry's risk (entry-to-stop distance).
# E.g. 2.0 exits once unrealized gain reaches 2x the risked amount. Set to 0
# to disable (winners only exit via EOD square-off).
ORB_TARGET_R=2.0

# First-half-hour -> last-half-hour momentum strategy. Compares price at the
# end of the opening window to the prior day's close: up -> long, down ->
# short. One entry per symbol per day, held until EOD square-off.
MOMENTUM_WINDOW_MINUTES=30
# Opening window's volume must be >= this multiple of the trailing lookback
# days' average opening-window volume. Set to 0 to disable.
MOMENTUM_VOLUME_MULTIPLIER=1.5
MOMENTUM_VOLUME_LOOKBACK=20

# Pairs trading (statistical arbitrage). Qualifying pairs + hedge ratios come
# from `python -m screening.pair_finder`, which should be re-run periodically
# (e.g. monthly) since cointegration relationships can break down over time.
PAIRS_CONFIG_PATH=config/pairs.json
# Rolling window (in candles) used for the spread's mean/stddev.
PAIRS_SPREAD_LOOKBACK=20
# Entry when the spread is this many stddevs from its rolling mean.
PAIRS_ENTRY_Z=2.0
# Exit once the spread reverts to within this many stddevs of the mean.
PAIRS_EXIT_Z=0.5

# Order params
MARKET_PROTECTION_PCT=1.0
SQUARE_OFF_TIME=15:20

# SQLite
DB_PATH=trader.db

# Cloudflare D1 dashboard sync (api/server.py's /sync endpoint).
# Account ID and D1 database ID from the Cloudflare dashboard; API token
# needs D1 edit permission on that database (create in My Profile -> API Tokens).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Shared secret the dashboard's Pages Function must present to trigger a sync.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_TOKEN=
# Must be one of Cloudflare's allowed outbound proxy ports for Workers/Pages
# Functions (HTTP: 80, 8080, 8880, 2052, 2082, 2086, 2095) or the dashboard's
# Refresh button will fail with "error code: 1003".
SYNC_API_PORT=8080
